# Copier ce fichier en .env puis adapter

# Serveur Ollama sur Colab (via Tailscale)
OLLAMA_BASE_URL=http://colab-gpu:11434
COLAB_NOTEBOOK_URL=
LLM_MODEL=qwen3-vl:32b
# LLM_MODEL=gemma4:31b
# LLM_MODEL=qwen3.5:35b
# LLM_MODEL=mistral-small3.2:24b  # plus leger pour L4
LLM_BACKEND=openai
LLM_NUM_CTX=65536
LLM_TIMEOUT=240
LLM_REASONING_EFFORT=low          # low | medium | high | off

# Tache par defaut (laisser START_URL vide pour le mode interactif)
START_URL=
TASK_OBJECTIVE=Résous intégralement l'exercice interactif affiché sur la page actuelle.
MAX_STEPS=40
MAX_ACTIONS_PER_STEP=5
CONFIRM_SUBMIT=false
ALLOW_ASK_HUMAN=true

# Navigateur
CHROME_PROFILE_DIR=./chrome_profile
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
ALLOWED_DOMAINS=

# Fichiers / LibreOffice
DOWNLOADS_DIR=./downloads
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
TOOL_MAX_CHARS=6000

ANONYMIZED_TELEMETRY=false
BROWSER_USE_LOGGING_LEVEL=info
